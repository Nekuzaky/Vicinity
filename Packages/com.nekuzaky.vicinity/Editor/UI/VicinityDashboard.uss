.vicinity-root {
    flex-grow: 1;
    background-color: rgb(30, 31, 34);
    color: rgb(215, 217, 221);
}

.vicinity-header {
    padding: 14px 16px 12px 16px;
    background-color: rgb(38, 40, 44);
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 61, 66);
}

.vicinity-title {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(230, 232, 236);
    margin-bottom: 2px;
}

.vicinity-subtitle {
    font-size: 11px;
    color: rgb(139, 145, 151);
    margin-bottom: 8px;
}

.vicinity-gizmo-toggle {
    font-size: 11px;
    color: rgb(154, 160, 166);
}

.vicinity-tab-bar {
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 12px;
    background-color: rgb(38, 40, 44);
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 61, 66);
}

.vicinity-tab {
    height: 30px;
    padding: 0 16px 0 16px;
    margin: 0 2px 0 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    font-size: 12px;
    color: rgb(139, 145, 151);
    transition-property: color;
    transition-duration: 0.12s;
}

.vicinity-tab:hover {
    color: rgb(215, 217, 221);
    background-color: rgba(0, 0, 0, 0);
}

.vicinity-tab--active {
    color: rgb(236, 238, 242);
    -unity-font-style: bold;
    border-bottom-color: rgb(90, 156, 242);
}

.vicinity-content {
    flex-grow: 1;
    padding: 6px 16px 16px 16px;
}

.vicinity-section-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(139, 145, 151);
    margin-top: 16px;
    margin-bottom: 6px;
}

.vicinity-row {
    flex-direction: row;
    align-items: center;
    padding: 9px 10px 9px 8px;
    margin-bottom: 5px;
    border-radius: 5px;
    background-color: rgb(38, 40, 44);
    border-width: 1px;
    border-color: rgb(52, 55, 61);
    border-left-width: 3px;
    border-left-color: rgb(66, 70, 77);
}

.vicinity-row:hover {
    background-color: rgb(42, 45, 50);
    border-color: rgb(58, 61, 66);
}

.vicinity-row--ok {
    border-left-color: rgb(92, 168, 118);
}

.vicinity-row--warn {
    border-left-color: rgb(208, 168, 84);
}

.vicinity-row--error {
    border-left-color: rgb(198, 96, 96);
}

.vicinity-row__icon {
    width: 16px;
    height: 16px;
    margin: 0 8px 0 4px;
    flex-shrink: 0;
}

.vicinity-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.vicinity-row__title {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(223, 225, 229);
    white-space: normal;
    margin-bottom: 2px;
}

.vicinity-row__detail {
    font-size: 11px;
    color: rgb(139, 145, 151);
    white-space: normal;
}

.vicinity-row__action {
    flex-shrink: 0;
    min-width: 132px;
    height: 24px;
    border-radius: 4px;
    font-size: 11px;
    background-color: rgb(52, 55, 61);
    border-width: 1px;
    border-color: rgb(66, 70, 77);
    color: rgb(220, 222, 226);
}

.vicinity-row__action:hover {
    background-color: rgb(58, 61, 66);
}

.vicinity-hero-button {
    height: 42px;
    margin: 6px 0 6px 0;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgb(70, 120, 205);
    border-width: 0;
    color: rgb(245, 248, 252);
}

.vicinity-hero-button:hover {
    background-color: rgb(84, 137, 224);
}

.vicinity-primary-actions {
    flex-direction: row;
    margin: 10px 0 4px 0;
}

.vicinity-primary-actions Button {
    flex-grow: 1;
    height: 30px;
    margin-right: 8px;
    border-radius: 5px;
    font-size: 12px;
    background-color: rgb(52, 55, 61);
    border-width: 1px;
    border-color: rgb(66, 70, 77);
    color: rgb(220, 222, 226);
}

.vicinity-primary-actions Button:hover {
    background-color: rgb(58, 61, 66);
}

.vicinity-primary-actions Button:disabled {
    opacity: 0.35;
}

.vicinity-foldout {
    margin: 4px 0 4px 0;
    font-size: 11px;
    color: rgb(139, 145, 151);
}

.vicinity-empty {
    font-size: 11px;
    color: rgb(139, 145, 151);
    margin: 12px 0 12px 0;
    white-space: normal;
}

.vicinity-stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.vicinity-stat {
    width: 108px;
    padding: 10px 12px 9px 12px;
    margin: 0 8px 8px 0;
    border-radius: 6px;
    background-color: rgb(38, 40, 44);
    border-width: 1px;
    border-color: rgb(52, 55, 61);
}

.vicinity-stat__value {
    -unity-font-style: bold;
    font-size: 22px;
    color: rgb(236, 238, 242);
    margin-bottom: 1px;
}

.vicinity-stat__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(139, 145, 151);
}

.vicinity-graph {
    height: 130px;
    margin: 8px 0 10px 0;
    border-radius: 6px;
    background-color: rgb(34, 36, 40);
    border-width: 1px;
    border-color: rgb(52, 55, 61);
}

.vicinity-memory-line {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 238, 242);
    margin-top: 2px;
}

.vicinity-candidate-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px 7px 8px;
    margin-bottom: 3px;
    border-radius: 5px;
    background-color: rgb(38, 40, 44);
    border-width: 1px;
    border-color: rgb(52, 55, 61);
}

.vicinity-candidate-row:hover {
    background-color: rgb(42, 45, 50);
    border-color: rgb(58, 61, 66);
}

.vicinity-footer {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding: 0 12px 0 10px;
    background-color: rgb(38, 40, 44);
    border-top-width: 1px;
    border-top-color: rgb(58, 61, 66);
}

.vicinity-footer__icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.vicinity-footer__text {
    font-size: 10px;
    color: rgb(139, 145, 151);
    flex-grow: 1;
}

.vicinity-footer__link {
    height: 18px;
    margin-left: 4px;
    padding: 0 8px 0 8px;
    border-radius: 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 10px;
    color: rgb(139, 145, 151);
}

.vicinity-footer__link:hover {
    background-color: rgb(52, 55, 61);
    color: rgb(90, 156, 242);
}

.vicinity-drop {
    min-height: 96px;
    margin: 8px 0 8px 0;
    padding: 20px 16px 20px 16px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgb(34, 36, 40);
    border-width: 1px;
    border-color: rgb(70, 75, 83);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.vicinity-drop:hover {
    border-color: rgb(86, 92, 101);
}

.vicinity-drop--hover {
    background-color: rgb(38, 48, 64);
    border-color: rgb(90, 156, 242);
}

.vicinity-drop--refused {
    background-color: rgb(46, 36, 38);
    border-color: rgb(198, 96, 96);
}

.vicinity-drop__headline {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(223, 225, 229);
    margin-bottom: 5px;
}

.vicinity-drop__detail {
    font-size: 11px;
    color: rgb(139, 145, 151);
    white-space: normal;
    -unity-text-align: middle-center;
}

.vicinity-doc-link {
    height: 20px;
    padding: 0 8px 0 8px;
    border-radius: 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    color: rgb(139, 145, 151);
}

.vicinity-doc-link:hover {
    background-color: rgb(52, 55, 61);
    color: rgb(90, 156, 242);
}

.vicinity-graph__toolbar {
    min-height: 34px;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(38, 40, 44);
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 61, 66);
}

.vicinity-graph__name {
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(230, 232, 236);
    margin: 0 14px 0 4px;
}

.vicinity-graph__hint {
    font-size: 11px;
    color: rgb(139, 145, 151);
    margin-right: 8px;
}

.vicinity-graph__sample {
    width: 92px;
    margin-right: 4px;
}

.vicinity-graph__status {
    min-height: 28px;
    padding: 0 14px 0 14px;
    -unity-text-align: middle-left;
    font-size: 11px;
    background-color: rgb(38, 40, 44);
    border-top-width: 1px;
    border-top-color: rgb(58, 61, 66);
    color: rgb(122, 186, 146);
}

.vicinity-graph__status--broken {
    color: rgb(214, 118, 118);
}

.vicinity-node {
    min-width: 172px;
}

.vicinity-node > #node-border {
    border-radius: 7px;
    border-width: 1px;
    border-color: rgb(58, 61, 66);
}

.vicinity-node #title {
    height: 30px;
    padding-left: 4px;
}

.vicinity-node #title-label {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(236, 238, 242);
    margin: 0 8px 0 8px;
}

.vicinity-node #contents {
    background-color: rgb(34, 36, 40);
}

.vicinity-node #input,
.vicinity-node #output {
    background-color: rgb(34, 36, 40);
}

.vicinity-node .port {
    font-size: 11px;
    color: rgb(154, 160, 166);
}

.vicinity-node__field {
    margin: 3px 8px 3px 8px;
    font-size: 11px;
}

.vicinity-node__preview {
    margin: 5px 8px 7px 8px;
    padding: 3px 7px 3px 7px;
    border-radius: 4px;
    background-color: rgb(42, 45, 50);
    border-width: 1px;
    border-color: rgb(58, 61, 66);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(90, 156, 242);
}

.vicinity-node--fact #title {
    background-color: rgb(44, 74, 108);
}

.vicinity-node--maths #title {
    background-color: rgb(52, 55, 61);
}

.vicinity-node--logic #title {
    background-color: rgb(78, 62, 100);
}

.vicinity-node--output #title {
    background-color: rgb(48, 88, 62);
}

.vicinity-node--output > #node-border {
    border-color: rgb(92, 168, 118);
    border-width: 2px;
}
